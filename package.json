{
  "name": "glyde",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @glyde/passenger run start",
    "typecheck": "npm --workspaces --if-present run typecheck && tsc -p scripts",
    "lint": "npm --workspaces --if-present run lint && eslint -c scripts/eslint.config.cjs scripts",
    "test": "npm --workspaces --if-present run test",
    "db:push": "set -a && . ./.env.local && set +a && supabase db push --linked -p \"$SUPABASE_DB_PASSWORD\"",
    "db:seed:build": "node scripts/build-seed.ts",
    "db:test": "node scripts/db-test.ts",
    "db:types": "set -a && . ./.env.local && set +a && supabase gen types typescript --linked --schema public > packages/domain/src/database.types.ts",
    "gps:replay": "node scripts/gps-replay.ts",
    "gps:watch": "node scripts/watch-positions.ts",
    "test:auth": "node scripts/test-auth-otp.ts",
    "fn:deploy": "set -a && . ./.env.local && set +a && supabase functions deploy --use-api --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:seed": "set -a && . ./.env.local && set +a && PGPASSWORD=\"$SUPABASE_DB_PASSWORD\" psql \"$(cat supabase/.temp/pooler-url)\" -q -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "test:payments": "node scripts/test-payments.ts",
    "dev:trips": "node scripts/dev-trips.ts",
    "seed:driver": "node scripts/seed-test-driver.ts",
    "dev:board": "node scripts/dev-board.ts",
    "test:driver": "node scripts/test-driver.ts",
    "gps:auto": "node scripts/gps-auto.ts",
    "dev:invite": "node scripts/dev-owner.ts invite",
    "dev:approve-driver": "node scripts/dev-owner.ts approve"
  },
  "devDependencies": {
    "supabase": "^2.120.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3"
  }
}
